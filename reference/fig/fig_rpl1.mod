var c k;
varexo x;
parameters alph gam delta bet aa;
alph=0.5; gam=0.5; delta=0.02; bet=0.05; aa=0.5;
model;
c + k - aa*x*k(-1)^alph - (1-delta)*k(-1);
c^(-gam) - (1+bet)^(-1)*(aa*alph*x(+1)*k^(alph-1) + 1 - delta)*c(+1)^(-gam);
end;
initval;
x = 1;
k = ((delta+bet)/(1.0*aa*alph))^(1/(alph-1));
c = aa*k^alph-delta*k;
end;
endval;
x = 1.1;
k = ((delta+bet)/(1.1*aa*alph))^(1/(alph-1));
c = aa*k^alph-delta*k;
end;
steady;
check;
perfect_foresight_setup(periods=80);
perfect_foresight_solver;
rplot c k;
options_.rplottype = 1;
rplot k x;
options_.rplottype = 2;
rplot c k x;
