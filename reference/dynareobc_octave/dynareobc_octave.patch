diff --git a/Core/Utils/ObtainRootConditionalCovariance.m b/Core/Utils/ObtainRootConditionalCovariance.m
index 9767d05..5a40fe5 100644
--- a/Core/Utils/ObtainRootConditionalCovariance.m
+++ b/Core/Utils/ObtainRootConditionalCovariance.m
@@ -1,7 +1,9 @@
 function RootConditionalCovariance = ObtainRootConditionalCovariance( ConditionalCovariance, PruningCutOff, MaxDimension )
     [U,D] = schur( ConditionalCovariance, 'complex' );
     % assert( isreal( U ) );
-    diagD = diag( D );
+    diagD = real( diag( D ) );
+    [ diagD, SortIdx ] = sort( diagD ); % Octave's schur does not order the eigenvalues; the truncation below needs ascending order
+    U = U( :, SortIdx );
     % assert( isreal( diagD ) );
     max_diagD = max( diagD );
     diagD( diagD < PruningCutOff * max_diagD ) = 0;
