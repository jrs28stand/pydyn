diff --git a/Core/MODProcessing/ProcessModFileText.m b/Core/MODProcessing/ProcessModFileText.m
index c3cd73d..8203a6b 100644
--- a/Core/MODProcessing/ProcessModFileText.m
+++ b/Core/MODProcessing/ProcessModFileText.m
@@ -13,7 +13,7 @@ function FileText = ProcessModFileText( FileText )
     FileText = regexprep( FileText, '\s+', ' ' );
     FileText = regexprep( FileText, '[ ]*;+[ ]*', ';\n' );
     % remove some unnecessary space
-    FileText = regexprep( FileText, '[ ]*([\(\)\+\-\*\/\^\>\<\=\!\,\[\]\#]+)[ ]*', '$1' );
+    FileText = regexprep( FileText, '[ ]*([()+\-*/^><=!,\[\]#]+)[ ]*', '$1' ); % Octave reads \< and \> as word anchors, even in a class
     FileText = regexprep( FileText, '^ | $', '', 'lineanchors' );
     FileText = regexprep( FileText, '[\n\r]+', '\n' );
     FileText = regexprep( FileText, '(^\s+|\s+$)', '' );
