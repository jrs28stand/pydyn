var c k y;
varexo e;
varexo_det z;
parameters alph bet delta rho;
alph = 0.36; bet = 0.99; delta = 0.025; rho = 0.9;
model;
c + k = y + (1-delta)*k(-1);
y = exp(e)*k(-1)^alph + z;
1/c = bet/c(+1)*(alph*y(+1)/k + 1 - delta);
end;
steady_state_model;
k = ((1/bet - 1 + delta)/alph)^(1/(alph-1));
y = k^alph;
c = y - delta*k;
end;
shocks;
var e; stderr 0.01;
end;
steady;
save_params_and_steady_state('pss1_out.txt');
