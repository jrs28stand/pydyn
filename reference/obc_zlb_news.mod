// Reference regime of zlb.mod with news shocks w_k (announced k periods ahead) on the reference equation.
var y pi r rn a;
varexo e w0 w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12 w13 w14 w15 w16 w17 w18 w19;
parameters beta phi rho rbar;
beta=0.99; phi=1.5; rho=0.8; rbar=-0.01;
model;
y = y(+1) - (r - pi(+1)) + a;
pi = beta*pi(+1) + 0.1*y;
rn = phi*pi;
r = rn + w0 + w1(-1) + w2(-2) + w3(-3) + w4(-4) + w5(-5) + w6(-6) + w7(-7) + w8(-8) + w9(-9) + w10(-10) + w11(-11) + w12(-12) + w13(-13) + w14(-14) + w15(-15) + w16(-16) + w17(-17) + w18(-18) + w19(-19);
a = rho*a(-1) + e;
end;
shocks;
var e; stderr 1;
var w0; stderr 1;
var w1; stderr 1;
var w2; stderr 1;
var w3; stderr 1;
var w4; stderr 1;
var w5; stderr 1;
var w6; stderr 1;
var w7; stderr 1;
var w8; stderr 1;
var w9; stderr 1;
var w10; stderr 1;
var w11; stderr 1;
var w12; stderr 1;
var w13; stderr 1;
var w14; stderr 1;
var w15; stderr 1;
var w16; stderr 1;
var w17; stderr 1;
var w18; stderr 1;
var w19; stderr 1;
end;
steady; check;
stoch_simul(order=1, irf=60, nograph, noprint);
